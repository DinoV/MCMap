<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MinecraftMapper</RootNamespace>
    <AssemblyName>MCMap</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CsvHelper" Version="7.1.1" />
    <ProjectReference Include="..\Substrate\SubstrateCS\Substrate.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="commercial.csv" CopyToOutputDirectory="PreserveNewest" />
    <None Update="residential.csv" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
